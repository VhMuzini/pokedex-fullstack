# Porta em que a API sobe
PORT=3333

# Origem permitida para CORS (URL do front-end Angular)
CORS_ORIGIN=http://localhost:4200

# Base da PokeAPI (dificilmente muda, mas fica configuravel)
POKEAPI_BASE_URL=https://pokeapi.co/api/v2

# Tempo de vida do cache em memoria, em segundos
CACHE_TTL_SECONDS=3600

# Janela e limite do rate limiter (protege contra abuso da API)
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
